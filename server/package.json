{
  "name": "dictprop-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --import ../test/support/isolated-env.ts --test --test-timeout=120000 'test/**/*.test.ts'",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.7",
    "hono": "^4.13.18",
    "jose": "^6.2.3",
    "ts-fsrs": "^5.4.1",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2"
  }
}
