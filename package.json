{
  "name": "popdict-vps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "npm run dev & npm run dev:server",
    "build": "vite build",
    "build:server": "cd server && npm run build",
    "build:all": "npm run build && npm run build:server",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "cd server && npm run typecheck",
    "test:server": "cd server && npm test",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:sw": "node --check public/sw.js",
    "check": "npm run typecheck && npm run typecheck:server && npm run test:server && npm run build:all && npm run check:bundle && npm run check:sw",
    "deploy": "./deploy.sh"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.3",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "canvas": "^3.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
